# Leave empty in development — Vite proxies /api to the backend.
# For production or the mobile app, set the full API origin, e.g.
# VITE_API_URL=https://api.gameon.app
VITE_API_URL=

# Map tiles. Both options are free and neither needs an API key or a card:
#   "osm"   — OpenStreetMap's own tiles (default)
#   "carto" — CARTO's lighter Voyager basemap
# There is deliberately NO Google Maps option. Google Maps requires a billing
# account, and a leaked key on a public repo becomes someone else's bill.
VITE_MAP_PROVIDER=osm

# Show the one-tap demo logins on the login page. Development always shows
# them; a deployed build must opt in, because those credentials are published
# in this repository and one of them is a venue-owner account with access to
# customer names, phone numbers and revenue.
VITE_SHOW_DEMO_LOGINS=false

# Set to "capacitor" when building the native shell, so Vite emits relative
# asset paths. Leave unset for the web — an absolute base is what makes deep
# links work.
# VITE_BUILD_TARGET=capacitor
