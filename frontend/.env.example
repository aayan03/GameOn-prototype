# Leave empty in development — Vite proxies /api to the backend.
# For production or the mobile app, set the full API origin, e.g.
# VITE_API_URL=https://api.gameon.app
VITE_API_URL=

# Map tiles. Both options are free and neither needs an API key or a card:
#   "osm"   — OpenStreetMap's own tiles (default)
#   "carto" — CARTO's lighter Voyager basemap
# There is deliberately NO Google Maps option. Google Maps requires a billing
# account, and a leaked key on a public repo becomes someone else's bill.
VITE_MAP_PROVIDER=osm
