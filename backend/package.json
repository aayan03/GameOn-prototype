{
  "name": "gameon-backend",
  "version": "4.0.0",
  "description": "GameOn \u2014 sports venue booking, TeamUp and loyalty API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
