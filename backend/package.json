{
  "name": "gameon-backend",
  "version": "4.0.0",
  "description": "GameOn \u2014 sports venue booking, TeamUp and loyalty API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "npm run test:unit && npm run test:integration",
    "seed:demo": "node src/seed/seed.js --no-lucknow",
    "seed:lucknow": "node src/seed/seed.js --lucknow-only",
    "check": "node tests/load.test.mjs",
    "test:unit": "node --test tests/boot.test.mjs && node tests/load.test.mjs && node --test tests/time.test.mjs && node --test tests/payout.test.mjs && node tests/booking.test.mjs && node tests/loyalty.test.mjs && node tests/phase4.test.mjs && node tests/phase5.test.mjs && node tests/email.test.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "check:email": "node scripts/check-email.mjs",
    "fix:indexes": "node scripts/fix-text-index.mjs",
    "purge:demo": "node scripts/purge-demo-data.mjs",
    "make:admin": "node scripts/make-admin.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.6",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
