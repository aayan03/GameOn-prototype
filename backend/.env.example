# ─────────────────────────────────────────────────────────────────
#  GameOn API configuration
#  Copy to .env and fill in. The server REFUSES to start in
#  production if the security-critical values are still defaults.
# ─────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Leave empty in development and an in-memory MongoDB starts
# automatically. REQUIRED in production.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/gameon
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────
# Generate each of these separately:
#   openssl rand -base64 48
# They must differ from each other and be at least 32 characters.
# NEVER commit real values, and never reuse them across environments.
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_too_another_random_string

# Short access token, long refresh token. Keep the access token short —
# it cannot be revoked before it expires.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of the exact origins allowed to call this API.
# In production this MUST be set and MUST NOT contain localhost.
# Capacitor origins are included so the future mobile app works.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost

# ── Payments ─────────────────────────────────────────────────────
# Set BOTH keys and the API takes real payments through Razorpay.
# Leave them empty and the wallet simulation runs instead — in that
# mode the card/UPI endpoints return 501 rather than pretending to
# verify a signature they have no secret for.
#
# Get these from dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this from Settings → Webhooks. Without it every webhook is
# rejected, so payments captured out-of-band never reconcile.
RAZORPAY_WEBHOOK_SECRET=

# Platform cut on each booking, used for owner payouts. A venue can
# override this with its own commissionPercent.
PLATFORM_COMMISSION_PERCENT=10

# ── Deployment ───────────────────────────────────────────────────
# Set true ONLY when running behind a proxy or load balancer
# (Render, Railway, Heroku, nginx). Leave false otherwise — trusting
# X-Forwarded-For when nothing sets it lets clients spoof their IP
# and bypass rate limiting.
TRUST_PROXY=false

# morgan format: dev | combined | tiny
LOG_LEVEL=dev

# Max request body size.
BODY_LIMIT=256kb

# Shared secret for POST /api/cron/lifecycle, so an external scheduler can run
# the housekeeping job without an admin login. Leave empty and the route 404s.
CRON_SECRET=

# ── Email (REQUIRED in production) ───────────────────────────────
# Set ONE of the three options below. The server refuses to boot in
# production without one, because a reset link is the only way back
# into a locked-out account.
#
# PREFER THE HTTP OPTIONS. Free hosting tiers - Render, Railway, Fly -
# block outbound SMTP ports (25/465/587) to stop spam. The failure is
# a connection TIMEOUT rather than an auth error, so it looks like a
# code problem when it is a firewall, and the same credentials work
# fine from a laptop. The HTTP providers post over 443 instead.

# Option 1 - Brevo (recommended). Free 300/day, verify one sender
# address rather than a whole domain. Dashboard -> SMTP & API -> API Keys.
BREVO_API_KEY=

# Option 2 - Resend. Also HTTPS, but needs a verified DOMAIN before it
# will send to addresses other than your own.
RESEND_API_KEY=

# Option 3 - SMTP. Works anywhere the ports are open.
# Password reset is the only way back into a locked-out account, so
# the server refuses to boot in production without these.
#
# Works with any provider that speaks SMTP: SES, Mailgun, Postmark,
# Resend, Brevo, or a Gmail app password for a small deployment.
# Port 465 uses implicit TLS; 587 upgrades via STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GameOn <no-reply@yourdomain.com>

# Public URL of the FRONTEND. Reset links in emails are built from it.
# Deliberately not derived from the request's Host header — a link built
# from an attacker-supplied header is a working account takeover.
# Defaults to the first non-wildcard CORS origin if left empty.
APP_URL=

# ── Web Push (optional) ──────────────────────────────────────────
# Generate a pair once:  npx web-push generate-vapid-keys
# Set both or neither. With them empty the app never asks the user for
# notification permission, rather than asking and never delivering.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ── Error tracking (optional but strongly recommended) ───────────
# A Sentry DSN. Unexpected 500s are reported with a request id; handled
# errors (a 400, a declined payment) are not — they would be noise.
SENTRY_DSN=
SERVICE_NAME=gameon-api
# Shown on each report so you can tell which deploy broke.
RELEASE=

# Application log level: debug | info | warn | error | silent
# Defaults to info in production, debug otherwise. Separate from
# LOG_LEVEL above, which is morgan's HTTP access-log format.
LOG_LEVEL_APP=

# ── Wallet ───────────────────────────────────────────────────────
# The simulated top-up creates spendable balance with nothing behind it:
# no card charged, no settlement, nothing to reconcile. On a live site
# that is a money printer, so it is OFF in production unless set here,
# and the server refuses to boot with it on while Razorpay is configured.
# Leave false unless this is a demo deployment.
ALLOW_SIMULATED_TOPUP=false

# ── Timezone ──────────────────────────────────────────────────
# The wall-clock every slot, opening hour and date key is expressed in.
# Slot times are stored as "YYYY-MM-DD" + minutes-from-midnight, and this is
# what converts them to real instants. Leave it unset and the app uses
# Asia/Kolkata; it does NOT fall back to the server's clock, deliberately —
# every free host runs UTC, and an implicit fallback is how the whole booking
# grid ended up 5.5 hours out. Any IANA name works.
APP_TIMEZONE=Asia/Kolkata
