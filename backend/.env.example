# ─────────────────────────────────────────────────────────────────
#  GameOn API configuration
#  Copy to .env and fill in. The server REFUSES to start in
#  production if the security-critical values are still defaults.
# ─────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Leave empty in development and an in-memory MongoDB starts
# automatically. REQUIRED in production.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/gameon
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────
# Generate each of these separately:
#   openssl rand -base64 48
# They must differ from each other and be at least 32 characters.
# NEVER commit real values, and never reuse them across environments.
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_too_another_random_string

# Short access token, long refresh token. Keep the access token short —
# it cannot be revoked before it expires.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of the exact origins allowed to call this API.
# In production this MUST be set and MUST NOT contain localhost.
# Capacitor origins are included so the future mobile app works.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost

# ── Payments ─────────────────────────────────────────────────────
# Set BOTH keys and the API takes real payments through Razorpay.
# Leave them empty and the wallet simulation runs instead — in that
# mode the card/UPI endpoints return 501 rather than pretending to
# verify a signature they have no secret for.
#
# Get these from dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this from Settings → Webhooks. Without it every webhook is
# rejected, so payments captured out-of-band never reconcile.
RAZORPAY_WEBHOOK_SECRET=

# Platform cut on each booking, used for owner payouts. A venue can
# override this with its own commissionPercent.
PLATFORM_COMMISSION_PERCENT=10

# ── Deployment ───────────────────────────────────────────────────
# Set true ONLY when running behind a proxy or load balancer
# (Render, Railway, Heroku, nginx). Leave false otherwise — trusting
# X-Forwarded-For when nothing sets it lets clients spoof their IP
# and bypass rate limiting.
TRUST_PROXY=false

# morgan format: dev | combined | tiny
LOG_LEVEL=dev

# Max request body size.
BODY_LIMIT=256kb
