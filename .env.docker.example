# Copy to .env before `docker compose up`.
# Generate each secret separately:  openssl rand -base64 48

MONGO_USER=gameon
MONGO_PASSWORD=change_me_to_something_long

JWT_SECRET=change_me_at_least_32_characters_long_random
JWT_REFRESH_SECRET=change_me_too_a_different_32_plus_char_random

# The origin the browser will load the site from.
CORS_ORIGINS=http://localhost:8080

# Leave the frontend value empty for same-origin, or set the API's public URL.
VITE_API_URL=

# Payments — empty runs the wallet simulation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10
